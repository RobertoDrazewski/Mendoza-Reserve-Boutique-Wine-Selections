# Copiá este archivo a .env (desarrollo local) y completá los valores reales.
# En Railway, estas mismas variables se cargan en Settings → Variables (no se sube el .env).

# --- Base de datos ---
# En producción (Aiven): usar los datos que da Aiven al crear el servicio MySQL, con DB_SSL=true.
# En desarrollo local (MariaDB/MySQL instalado en tu máquina): DB_SSL=false.
DB_HOST=localhost
DB_USER=mendoza_dev
DB_PASSWORD=devpassword123
DB_NAME=mendoza_reserve_test
DB_PORT=3306
DB_SSL=false

# --- Auth ---
# Generar uno random y largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_valor_random_largo

# --- Server ---
PORT=4000
# Dominio del frontend permitido por CORS además de mendoza-reserve.co.uk (ej. el que asigne Railway)
EXTRA_CORS_ORIGIN=

# --- Imágenes subidas a mano (fotos de bodegas desde el panel admin) ---
# Sin esta variable, se guardan en backend/images (anda bien en local, pero en Railway
# esa carpeta es EFÍMERA: se borra en cada redeploy y las fotos subidas se pierden).
# Para que las fotos persistan en Railway:
#   1) En el proyecto de Railway: Settings → Volumes → New Volume, montado en un path
#      propio, por ejemplo /data
#   2) Seteá acá: IMAGES_DIR=/data/images
# (No hace falta copiar nada a mano: la carpeta bodegas/ adentro se crea sola.)
IMAGES_DIR=

# --- Emails transaccionales (Fase 3) ---
# Sin RESEND_API_KEY, los emails se loguean en consola en vez de enviarse (no rompe nada).
RESEND_API_KEY=
EMAIL_FROM=Mendoza Reserve <pedidos@mendoza-reserve.co.uk>
# URL pública del sitio (se usa en los links de los emails). En Railway, la URL final del dominio.
SITE_URL=https://mendoza-reserve.co.uk
# Casilla interna donde llegan: (a) el formulario de contacto del sitio, y (b) un aviso cuando
# alguien manda el primer mensaje del chat de IA (para saber que hay una consulta en curso).
# Si se deja vacío, esos dos avisos simplemente no se mandan — no rompe nada del resto.
ADMIN_NOTIFY_EMAIL=mendozareserve@gmail.com

# --- Reserva del comprador (Merchant API de Revolut Business) ---
# Se usa SOLO para cobrarle al comprador la "reserva" (comisión del 12%) — Mendoza
# Reserve nunca cobra ni retiene la plata de la bodega, eso lo cobra ella directo.
# Se saca en Revolut Business: Settings → APIs → Merchant API → Secret Key.
# Arrancá con REVOLUT_ENV=sandbox para probar sin plata real; pasá a production recién
# cuando esté todo probado de punta a punta.
REVOLUT_SECRET_KEY=
REVOLUT_ENV=sandbox
REVOLUT_API_VERSION=2026-08-17
# Este valor NO se pone a mano: sale de correr `npm run setup-revolut-webhook` una vez
# (por ambiente — una vez en sandbox, otra vez cuando pasés a production), que registra
# el webhook en Revolut y te devuelve el secret para pegarlo acá.
REVOLUT_WEBHOOK_SECRET=

# --- Chat con IA de seguimiento de pedido (Fase 5) ---
# Tu PROPIA API key de OpenAI para el SaaS — se saca en https://platform.openai.com/api-keys.
# Sin esta variable, el chat responde "no configurado" pero el resto del sitio funciona igual.
OPENAI_API_KEY=
# Modelo a usar (chico y económico alcanza para este chat acotado, que sólo hace una consulta
# puntual con function-calling). Podés revisar los modelos disponibles en
# https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-5.6-luna
